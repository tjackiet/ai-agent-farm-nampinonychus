<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ナンピノニクスを15分ごとに実行する launchd の定義（雛形）。
  __REPO__ と __PATH__ を置き換えてから ~/Library/LaunchAgents へ置く。
  手順は README.md「定期実行」を参照。

  PATH を明示するのは、launchd の既定の PATH に npm のグローバル配置先が
  含まれず、bitbank コマンドが見つからないため。bitbank は #!/usr/bin/env node
  で起動するので、node と同じディレクトリを指すこと。

  fnm / nvm / volta を使っている場合、which bitbank はシェルごとの
  使い捨てディレクトリを返す。そのまま書くとシェルを閉じた時点で壊れる。

  narrate を使うなら claude のディレクトリも並べること。bitbank と同じとは
  限らない（公式インストーラなら ~/.local/bin）。入れ忘れると売買は続くが、
  所感と学びだけが空欄のまま残り、原因は var/run.err.log にしか出ない。

  通知を使うなら NAMPINONYCHUS_WEBHOOK_URL も要る（下の EnvironmentVariables）。
  launchd は起動したシェルの環境変数を引き継がない。ログインシェルで export
  していてもここに無ければ通知は送られず、黙ったまま気づけない。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.nampinonychus</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>-m</string>
    <string>nampinonychus.run</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>

    <!--
      通知を使うなら、下の2行のコメントを外して Webhook の URL を入れる。
      通知は任意なので、雛形では外してある。

      入れた plist は ~/Library/LaunchAgents にだけ置き、リポジトリへ戻さないこと
      （CLAUDE.md「API キー・シークレット・プロファイル名は、ログにも記憶にも残さない」）。

      渡っているかは値を出さずに確かめられる。
        launchctl print gui/$(id -u)/local.nampinonychus | grep -c NAMPINONYCHUS_WEBHOOK_URL
    -->
    <!--
    <key>NAMPINONYCHUS_WEBHOOK_URL</key>
    <string>ここに Webhook の URL</string>
    -->

    <!--
      claude のログインを1年もたせるなら、下の2行のコメントを外し、
      claude setup-token が表示したトークンを入れる（README「claude のログインを1年もたせる」）。
      /login のログインは約1か月で切れ、切れると拒否権を諮れず買いが止まる
      （2026-09-04 と 2026-10-12 に起きた）。

      引かれるのは /login と同じサブスクリプションの利用枠。ただし agent.yaml の
      bare を true にすると読まれない。ANTHROPIC_API_KEY があればそちらが優先される。
      入れている間は /login のログインより優先されるので、切れたら /login ではなく
      トークンを発行し直して差し替える。URL と同じく、リポジトリへ戻さないこと。

      渡っているかは値を出さずに確かめられる。
        launchctl print gui/$(id -u)/local.nampinonychus | grep -c CLAUDE_CODE_OAUTH_TOKEN
    -->
    <!--
    <key>CLAUDE_CODE_OAUTH_TOKEN</key>
    <string>ここに claude setup-token のトークン</string>
    -->
  </dict>

  <!-- 15分ごと。スリープ中は動かず、復帰後に一度だけ実行される。 -->
  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__REPO__/var/run.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/var/run.err.log</string>
</dict>
</plist>
